# From your Supabase project: Project Settings → API. Leave empty to run without accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI assist (optional). Server-only: no NEXT_PUBLIC_ prefix, read only by the /api/ai route handlers.
# Set these in the Vercel project settings (Settings → Environment Variables), never in a committed file.
# Without ANTHROPIC_API_KEY the site works normally and simply shows no AI buttons to members.
# Anthropic API key from console.anthropic.com. Required to switch AI assist on.
ANTHROPIC_API_KEY=
# Optional: one model id for every AI task. Default: claude-haiku-5-5 for quick tasks, claude-sonnet-5-5 for drafting.
AI_MODEL=
# Optional: AI requests per member per day (default 30). Moderators and admins get five times as many.
AI_DAILY_LIMIT=

# Papers (optional). Server-only. A free key from openalex.org raises the daily allowance for citation data.
OPENALEX_API_KEY=
# Optional: contact address sent to OpenAlex with each request.
OPENALEX_EMAIL=
