# From your Supabase project: Project Settings → API. Leave empty to run without accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Free AI providers. Server-only (never NEXT_PUBLIC_). Set at least one; AI stays off without them. No paid API is used.
# Set these in Vercel (Settings → Environment Variables), never in a committed file.
# Google AI Studio, free key, no card: https://aistudio.google.com/apikey (free-tier prompts may be used by Google to improve products)
GEMINI_API_KEY=
# Groq free plan: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter, ":free" models only, 50 requests/day: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Cloudflare Workers AI, 10,000 free Neurons/day. Account id = the 32-char id in your dashboard URL; token with "Workers AI" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Mistral free Experiment plan (optional reserve): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Optional: secret for AI cache keys (any long random string). Without it, one is derived from the provider keys.
AI_CACHE_SECRET=
# Optional, server only: lets the daily newsroom cron and AI counters work without a signed-in member.
SUPABASE_SERVICE_ROLE_KEY=
# Newsroom: secret Vercel sends to the daily cron (at least 16 characters). Server only.
CRON_SECRET=
# Optional, server only: read-only GitHub token so /code/import and the GitHub repos page avoid the 60 requests per hour limit.
GITHUB_TOKEN=
